# =============================================================================
# LuminaFM Backend - Development Dockerfile with Hot-Reloading
# =============================================================================
FROM node:22-alpine

WORKDIR /app

# Install OpenSSL for Prisma and build tools
RUN apk add --no-cache openssl postgresql-client

COPY package.json package-lock.json* ./
RUN npm install

COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src

EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000

CMD ["npm", "run", "dev"]
