# =============================================================================
# LuminaFM Enterprise CMMS & ANP Decision Support Platform
# Commercial Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Server & Environment
# -----------------------------------------------------------------------------
NODE_ENV="development" # development | test | production
PORT=3000
HOST="0.0.0.0"
DEPLOYMENT_MODEL="saas" # saas (shared multi-tenant) | dedicated (single-tenant)
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://localhost:3000"

# -----------------------------------------------------------------------------
# 2. Database Connection & Connection Pool
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://luminafm:luminafm_secret_2026@localhost:5432/luminafm_db?schema=public&connection_limit=25&pool_timeout=10"
DATABASE_POOL_SIZE=25
DATABASE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# 3. Security & Secret Management
# In production, JWT_SECRET must be at least 32 characters and cryptographically random.
# Never use default or easily guessable secrets in production.
# -----------------------------------------------------------------------------
JWT_SECRET="lumina-fm-super-secret-production-key-change-in-prod"
# Optional secondary secret for zero-downtime key rotation
JWT_SECRET_SECONDARY=""
JWT_EXPIRES_IN="24h"

# -----------------------------------------------------------------------------
# 4. Storage Persistence (Evidence Vault & Logos)
# -----------------------------------------------------------------------------
STORAGE_DRIVER="local" # local | s3
STORAGE_LOCAL_PATH="./uploads"

# S3 / MinIO Object Storage Configuration (Required if STORAGE_DRIVER="s3")
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="luminafm-evidence-vault"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_USE_SSL="false"

# -----------------------------------------------------------------------------
# 5. Distributed Cache & Rate Limiting
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_MAX=10          # Max attempts per minute on /api/auth/login
RATE_LIMIT_STANDARD_MAX=300     # Max requests per minute on standard API routes
RATE_LIMIT_OPERATIONS_MAX=1000  # Max requests per minute on operator sync/logbooks

# -----------------------------------------------------------------------------
# 6. Automated Backup & Disaster Recovery
# -----------------------------------------------------------------------------
BACKUP_STORAGE_PATH="./backups"
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE="0 2 * * *" # Daily at 02:00 UTC
BACKUP_COMPRESSION_LEVEL=6

# -----------------------------------------------------------------------------
# 7. Observability, Structured Logging & Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL="info" # debug | info | warn | error
LOG_FORMAT="json" # json | pretty
PROMETHEUS_METRICS_ENABLED="true"
