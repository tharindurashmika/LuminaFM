# LuminaFM Production Commercial Deployment Configuration
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"
DEPLOYMENT_MODEL="saas"
CORS_ALLOWED_ORIGINS="https://app.luminafm.com,https://*.luminafm.com"

# Managed PostgreSQL Connection Pool with SSL and high availability
DATABASE_URL="postgresql://luminafm_prod_user:SECURE_VAULT_PASSWORD@postgres.internal:5432/luminafm_prod?schema=public&sslmode=require&connection_limit=50&pool_timeout=15"
DATABASE_POOL_SIZE=50
DATABASE_TIMEOUT_MS=15000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# High-entropy 64-character secret generated via cryptographic CSPRNG
JWT_SECRET="9d7e6f8a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e"
# Secondary rotation secret for seamless key rollover
JWT_SECRET_SECONDARY="1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b"
JWT_EXPIRES_IN="12h"

# Scalable Object Storage (S3 / Cloudflare R2 / MinIO Cluster)
STORAGE_DRIVER="s3"
STORAGE_LOCAL_PATH="/app/uploads"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET="luminafm-commercial-evidence-vault"
S3_ACCESS_KEY="LUMINA_IAM_ACCESS_KEY_SECURE"
S3_SECRET_KEY="LUMINA_IAM_SECRET_KEY_SECURE"
S3_USE_SSL="true"

# Distributed Redis Cluster for distributed rate limiting & token blacklist
REDIS_URL="redis://:REDIS_AUTH_TOKEN@redis.internal:6379/0"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_STANDARD_MAX=300
RATE_LIMIT_OPERATIONS_MAX=1000

# Automated Disaster Recovery & Encryption
BACKUP_STORAGE_PATH="/var/backups/luminafm"
BACKUP_RETENTION_DAYS=90
BACKUP_CRON_SCHEDULE="0 2 * * *"
BACKUP_COMPRESSION_LEVEL=9

# Structured JSON Logging for Datadog / CloudWatch / ELK Ingestion
LOG_LEVEL="info"
LOG_FORMAT="json"
PROMETHEUS_METRICS_ENABLED="true"
