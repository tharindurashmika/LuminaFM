# LuminaFM Automated Test Suite Configuration
NODE_ENV="test"
PORT=3001
HOST="127.0.0.1"
DEPLOYMENT_MODEL="saas"
CORS_ALLOWED_ORIGINS="http://localhost:3001"

DATABASE_URL="postgresql://luminafm_test:luminafm_test@localhost:5432/luminafm_test_db?schema=public"
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT_MS=3000

JWT_SECRET="lumina-fm-test-suite-secret-key-32chars-fixture"
JWT_SECRET_SECONDARY="lumina-fm-test-suite-secondary-rotation-key"
JWT_EXPIRES_IN="2h"

STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./test-uploads"

RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_STANDARD_MAX=50
RATE_LIMIT_OPERATIONS_MAX=100

BACKUP_STORAGE_PATH="./test-backups"
BACKUP_RETENTION_DAYS=1

LOG_LEVEL="error"
LOG_FORMAT="json"
PROMETHEUS_METRICS_ENABLED="true"
