# LuminaFM Development Configuration
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"
DEPLOYMENT_MODEL="saas"
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://localhost:3000,http://localhost:5173"

DATABASE_URL="postgresql://luminafm:luminafm_secret_2026@localhost:5432/luminafm_db?schema=public"
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000

JWT_SECRET="lumina-fm-dev-secret-key-32chars-min-dev-only"
JWT_EXPIRES_IN="24h"

STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"

REDIS_URL="redis://localhost:6379"
RATE_LIMIT_ENABLED="false"

BACKUP_STORAGE_PATH="./backups"
BACKUP_RETENTION_DAYS=7

LOG_LEVEL="debug"
LOG_FORMAT="pretty"
PROMETHEUS_METRICS_ENABLED="true"
