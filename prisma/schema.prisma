  organizationId  String              @map("organization_id") @db.Uuid
  code            String              @db.VarChar(80)
  name            String              @db.VarChar(200)
  modelMethod     DecisionModelMethod @default(ANP) @map("model_method")
  systemTypeId    String?             @map("system_type_id") @db.Uuid
  assetCategoryId String?             @map("asset_category_id") @db.Uuid
  version         Int                 @default(1)
  configuration   Json                @default("{}") @db.JsonB
  status          DecisionModelStatus @default(draft)
  effectiveFrom   DateTime?           @map("effective_from") @db.Date
  effectiveTo     DateTime?           @map("effective_to") @db.Date
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  systemType          SystemType?                  @relation(fields: [systemTypeId], references: [id], onDelete: SetNull)
  assetCategory       AssetCategory?               @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)
  criteria            DecisionCriterion[]
  alternatives        DecisionAlternative[]
  runs                DecisionRun[]
  pairwiseComparisons DecisionPairwiseComparison[]
  networkEdges        DecisionNetworkEdge[]

  @@unique([organizationId, code, version])
  @@unique([organizationId, id])
  @@map("decision_models")
}

model DecisionCriterion {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  decisionModelId     String        @map("decision_model_id") @db.Uuid
  parentCriterionId   String?       @map("parent_criterion_id") @db.Uuid
  clusterCode         String        @default("criteria") @map("cluster_code") @db.VarChar(50)
  code                String        @db.VarChar(80)
  name                String        @db.VarChar(160)
  description         String?       @db.Text
  criterionType       CriterionType @default(benefit) @map("criterion_type")
  weight              Decimal?      @db.Decimal(12, 8)
  benchmarkValue      Decimal?      @map("benchmark_value") @db.Decimal(20, 6)
  benchmarkOperator   String?       @map("benchmark_operator") @db.VarChar(20)
  unitOfMeasurementId String?       @map("unit_of_measurement_id") @db.Uuid
  meterDefinitionId   String?       @map("meter_definition_id") @db.Uuid
  checklistItemId     String?       @map("checklist_item_id") @db.Uuid
  sequenceNo          Int           @default(1) @map("sequence_no")

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionModel     DecisionModel      @relation(fields: [decisionModelId], references: [id], onDelete: Cascade)
  unitOfMeasurement UnitOfMeasurement? @relation(fields: [unitOfMeasurementId], references: [id], onDelete: SetNull)
  meterDefinition   MeterDefinition?   @relation(fields: [meterDefinitionId], references: [id], onDelete: SetNull)
  checklistItem     ChecklistItem?     @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  // Self-referencing hierarchical relationship
  parent              DecisionCriterion?           @relation("DecisionCriterionHierarchy", fields: [parentCriterionId], references: [id], onDelete: Restrict)
  children            DecisionCriterion[]          @relation("DecisionCriterionHierarchy")
  outgoingEdges       DecisionNetworkEdge[]        @relation("NetworkEdgeFrom")
  incomingEdges       DecisionNetworkEdge[]        @relation("NetworkEdgeTo")
  pairwiseComparisons DecisionPairwiseComparison[] @relation("PairwiseCriterion")

  @@unique([organizationId, decisionModelId, code])
  @@unique([organizationId, id])
  @@index([organizationId, decisionModelId, clusterCode])
  @@map("decision_criteria")
}

model DecisionAlternative {
  id                        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String  @map("organization_id") @db.Uuid
  decisionModelId           String  @map("decision_model_id") @db.Uuid
  code                      String  @db.VarChar(80)
  name                      String  @db.VarChar(160)
  description               String? @db.Text
  category                  String? @db.VarChar(50)
  componentCode             String? @map("component_code") @db.VarChar(50)
  maintenanceTaskTemplateId String? @map("maintenance_task_template_id") @db.Uuid

  // Relations
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionModel           DecisionModel            @relation(fields: [decisionModelId], references: [id], onDelete: Cascade)
  maintenanceTaskTemplate MaintenanceTaskTemplate? @relation(fields: [maintenanceTaskTemplateId], references: [id], onDelete: SetNull)
  notifications           Notification[]

  @@unique([organizationId, decisionModelId, code])
  @@unique([organizationId, id])
  @@map("decision_alternatives")
}

model DecisionRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  decisionModelId   String   @map("decision_model_id") @db.Uuid
  assetId           String?  @map("asset_id") @db.Uuid
  workOrderId       String?  @map("work_order_id") @db.Uuid
  runAt             DateTime @default(now()) @map("run_at") @db.Timestamptz(6)
  inputSnapshot     Json     @default("{}") @map("input_snapshot") @db.JsonB
  resultSnapshot    Json     @default("{}") @map("result_snapshot") @db.JsonB
  recommendedAction String?  @map("recommended_action") @db.Text
  confidenceScore   Decimal? @map("confidence_score") @db.Decimal(8, 6)
  triggerType       String   @default("manual") @map("trigger_type") @db.VarChar(40)
  clientLogUuid     String?  @map("client_log_uuid") @db.Uuid
  executedBy        String?  @map("executed_by") @db.Uuid

  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionModel  DecisionModel  @relation(fields: [decisionModelId], references: [id], onDelete: Restrict)
  asset          Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  workOrder      WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  executedByUser User?          @relation("DecisionRunExecutedBy", fields: [executedBy], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([organizationId, assetId, runAt(sort: Desc)], map: "idx_decision_runs_asset_time")
  @@map("decision_runs")
}

// =============================================================================
// 10. NOTIFICATIONS, ATTACHMENTS AND AUDIT
// =============================================================================

model Attachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fileName       String   @map("file_name") @db.VarChar(255)
  storageUri     String   @map("storage_uri") @db.Text
  mimeType       String?  @map("mime_type") @db.VarChar(150)
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser    User?              @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)
  entityAttachments EntityAttachment[]

  @@map("attachments")
}

model EntityAttachment {
  organizationId String @map("organization_id") @db.Uuid
  attachmentId   String @map("attachment_id") @db.Uuid
  entityType     String @map("entity_type") @db.VarChar(50)
  entityId       String @map("entity_id") @db.Uuid

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attachment   Attachment   @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([organizationId, attachmentId, entityType, entityId])
  @@map("entity_attachments")
}

model Notification {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  notificationType      String    @map("notification_type") @db.VarChar(80)
  title                 String    @db.VarChar(200)
  message               String    @db.Text
  severity              String    @default("info") @db.VarChar(20)
  status                String    @default("pending") @db.VarChar(20)
  decisionRunId         String?   @map("decision_run_id") @db.Uuid
  decisionAlternativeId String?   @map("decision_alternative_id") @db.Uuid
  entityType            String?   @map("entity_type") @db.VarChar(50)
  entityId              String?   @map("entity_id") @db.Uuid
  readAt                DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionRun         DecisionRun?         @relation(fields: [decisionRunId], references: [id], onDelete: SetNull)
  decisionAlternative DecisionAlternative? @relation(fields: [decisionAlternativeId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt(sort: Desc)], map: "idx_notifications_user_unread")
  @@index([organizationId, status, severity])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(80)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.Uuid
  oldValues      Json?    @map("old_values") @db.JsonB
  newValues      Json?    @map("new_values") @db.JsonB
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)], map: "idx_audit_entity_time")
  @@map("audit_logs")
}

// =============================================================================
// OFFLINE SYNCHRONIZATION AND ANP NETWORK EXTENSIONS
// =============================================================================

model OfflineSyncBatch {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  batchUuid      String          @map("batch_uuid") @db.Uuid
  deviceId       String          @map("device_id") @db.VarChar(120)
  userId         String          @map("user_id") @db.Uuid
  status         SyncBatchStatus @default(received)
  payloadSummary Json            @default("{}") @map("payload_summary") @db.JsonB
  errorLog       String?         @map("error_log") @db.Text
  syncedAt       DateTime        @default(now()) @map("synced_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("SyncBatchUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, batchUuid])
  @@unique([organizationId, id])
  @@index([organizationId, deviceId, syncedAt(sort: Desc)])
  @@map("offline_sync_batches")
}

model DecisionPairwiseComparison {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  decisionModelId String   @map("decision_model_id") @db.Uuid
  clusterCode     String   @map("cluster_code") @db.VarChar(50)
  criterionId     String?  @map("criterion_id") @db.Uuid
  rowElementId    String   @map("row_element_id") @db.Uuid
  colElementId    String   @map("col_element_id") @db.Uuid
  saatyValue      Decimal  @map("saaty_value") @db.Decimal(8, 4)
  evaluatorUserId String?  @map("evaluator_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionModel DecisionModel      @relation(fields: [decisionModelId], references: [id], onDelete: Cascade)
  criterion     DecisionCriterion? @relation("PairwiseCriterion", fields: [criterionId], references: [id], onDelete: Cascade)
  evaluatorUser User?              @relation("PairwiseEvaluator", fields: [evaluatorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, decisionModelId, clusterCode, criterionId, rowElementId, colElementId], map: "uq_decision_pairwise_cell")
  @@unique([organizationId, id])
  @@index([organizationId, decisionModelId, clusterCode])
  @@map("decision_pairwise_comparisons")
}

model DecisionNetworkEdge {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  decisionModelId String   @map("decision_model_id") @db.Uuid
  fromCriterionId String   @map("from_criterion_id") @db.Uuid
  toCriterionId   String   @map("to_criterion_id") @db.Uuid
  edgeType        String   @default("inner_dependence") @map("edge_type") @db.VarChar(40)
  weight          Decimal? @db.Decimal(12, 8)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionModel DecisionModel     @relation(fields: [decisionModelId], references: [id], onDelete: Cascade)
  fromCriterion DecisionCriterion @relation("NetworkEdgeFrom", fields: [fromCriterionId], references: [id], onDelete: Cascade)
  toCriterion   DecisionCriterion @relation("NetworkEdgeTo", fields: [toCriterionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, decisionModelId, fromCriterionId, toCriterionId], map: "uq_decision_network_edge")
  @@unique([organizationId, id])
  @@map("decision_network_edges")
}
