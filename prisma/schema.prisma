model Inspection {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                   @map("organization_id") @db.Uuid
  inspectionNumber    String                   @map("inspection_number") @db.VarChar(80)
  checklistTemplateId String                   @map("checklist_template_id") @db.Uuid
  assetId             String?                  @map("asset_id") @db.Uuid
  locationId          String?                  @map("location_id") @db.Uuid
  workOrderId         String?                  @map("work_order_id") @db.Uuid
  status              InspectionStatus         @default(draft)
  scheduledAt         DateTime?                @map("scheduled_at") @db.Timestamptz(6)
  startedAt           DateTime?                @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?                @map("completed_at") @db.Timestamptz(6)
  inspectorId         String?                  @map("inspector_id") @db.Uuid
  clientLogUuid       String?                  @map("client_log_uuid") @db.Uuid
  syncStatus          SyncStatus               @default(synced) @map("sync_status")
  clientStartedAt     DateTime?                @map("client_started_at") @db.Timestamptz(6)
  clientCompletedAt   DateTime?                @map("client_completed_at") @db.Timestamptz(6)
  overallResult       InspectionOverallResult? @map("overall_result")
  notes               String?                  @db.Text

  // Relations
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate    @relation(fields: [checklistTemplateId], references: [id], onDelete: Restrict)
  asset             Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  location          Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workOrder         WorkOrder?           @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  inspector         User?                @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  responses         InspectionResponse[]

  @@unique([organizationId, inspectionNumber])
  @@unique([organizationId, clientLogUuid])
  @@unique([organizationId, id])
  @@index([organizationId, assetId, completedAt(sort: Desc)], map: "idx_inspections_asset_time")
  @@map("inspections")
}

model InspectionResponse {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  inspectionId    String                  @map("inspection_id") @db.Uuid
  checklistItemId String                  @map("checklist_item_id") @db.Uuid
  responseText    String?                 @map("response_text") @db.Text
  responseNumber  Decimal?                @map("response_number") @db.Decimal(20, 6)
  responseBoolean Boolean?                @map("response_boolean")
  responseDate    DateTime?               @map("response_date") @db.Date
  responseJson    Json?                   @map("response_json") @db.JsonB
  resultStatus    InspectionResultStatus? @map("result_status")
  notes           String?                 @db.Text
  evidenceUri     String?                 @map("evidence_uri") @db.Text
  syncStatus      SyncStatus?             @default(synced) @map("sync_status")
  respondedBy     String?                 @map("responded_by") @db.Uuid
  respondedAt     DateTime                @default(now()) @map("responded_at") @db.Timestamptz(6)

  // Relations
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection      Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  respondedByUser User?         @relation("InspectionResponseBy", fields: [respondedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, inspectionId, checklistItemId])
  @@map("inspection_responses")
}

