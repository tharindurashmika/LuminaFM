  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  updatedByUser       User?               @relation("AttributeValueUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, assetId, attributeDefinitionId])
  @@index([organizationId, attributeDefinitionId, valueNumber], map: "idx_asset_attr_number")
