// =============================================================================
// LuminaFM CMMS - Multi-Tenant Enterprise Database Schema
// =============================================================================
// Generator & Datasource Configuration
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum CriticalityLevel {
  low
  medium
  high
  critical

  @@map("criticality_level")
}

enum SystemStatus {
  active
  inactive
  decommissioned

  @@map("system_status")
}

enum AssetStatus {
  in_service
  out_of_service
  under_maintenance
  standby
  decommissioned

  @@map("asset_status")
}

enum AttributeDataType {
  text
  number
  boolean
  date
  datetime
  select
  multi_select

  @@map("attribute_data_type")
}

enum MeterReadingType {
  instantaneous
  cumulative
  counter

  @@map("meter_reading_type")
}

enum ReadingSource {
  manual
  iot
  import
  calculated

  @@map("reading_source")
}

enum ReadingQualityStatus {
  valid
  suspect
  invalid

  @@map("reading_quality_status")
}

enum RecurrenceType {
  calendar
  meter
  condition
  one_time

  @@map("recurrence_type")
}

enum PriorityLevel {
  low
  medium
  high
  urgent

  @@map("priority_level")
}

enum WorkOrderStatus {
  draft
  open
  approved
  assigned
  in_progress
  on_hold
  completed
  cancelled
  closed

  @@map("work_order_status")
}

enum WorkOrderTaskStatus {
  pending
  in_progress
  completed
  skipped

  @@map("work_order_task_status")
}

enum ChecklistResponseType {
  pass_fail
  yes_no
  number
  text
  date
  photo
  select

  @@map("checklist_response_type")
}

enum InspectionStatus {
  draft
  in_progress
  completed
  failed
  cancelled

  @@map("inspection_status")
}

enum InspectionOverallResult {
  pass
  fail
  conditional
  not_applicable

  @@map("inspection_overall_result")
}

enum InspectionResultStatus {
  pass
  fail
  observation
  not_applicable

  @@map("inspection_result_status")
}

enum FaultStatus {
  open
  investigating
  work_order_created
  resolved
  closed

  @@map("fault_status")
}

enum DecisionModelMethod {
  ANP
  AHP
  TOPSIS
  FUZZY
  CUSTOM

  @@map("decision_model_method")
}

enum DecisionModelStatus {
  draft
  validated
  active
  retired

  @@map("decision_model_status")
}

enum CriterionType {
  benefit
  cost
  risk
  custom

  @@map("criterion_type")
}

// =============================================================================
// 1. TENANCY, USERS AND ACCESS CONTROL
// =============================================================================

enum DeploymentMode {
  saas_multitenant
  dedicated

  @@map("deployment_mode")
}

enum SyncStatus {
  synced
  pending
  conflict

  @@map("sync_status")
}

enum SyncBatchStatus {
  received
  processed
  partial
  failed

  @@map("sync_batch_status")
}

model Organization {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String         @unique @db.VarChar(50)
  name               String         @db.VarChar(200)
  legalName          String?        @map("legal_name") @db.VarChar(250)
  logoUri            String?        @map("logo_uri") @db.Text
  timezone           String         @default("Asia/Colombo") @db.VarChar(80)
  baseCurrency       String         @default("LKR") @map("base_currency") @db.Char(3)
  branding           Json           @default("{}") @db.JsonB
  deploymentMode     DeploymentMode @default(saas_multitenant) @map("deployment_mode")
  deploymentSettings Json           @default("{}") @map("deployment_settings") @db.JsonB
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  memberships                 OrganizationMembership[]
  roles                       Role[]
  rolePermissions             RolePermission[]
  membershipRoles             MembershipRole[]
  sites                       Site[]
  locationTypes               LocationType[]
  locations                   Location[]
  systemCategories            SystemCategory[]
  systemTypes                 SystemType[]
  systems                     System[]
  assetCategories             AssetCategory[]
  brands                      Brand[]
  assetModels                 AssetModel[]
  assets                      Asset[]
  attributeDefinitions        AttributeDefinition[]
  categoryAttributes          CategoryAttribute[]
  assetAttributeValues        AssetAttributeValue[]
  unitsOfMeasurement          UnitOfMeasurement[]
  meterDefinitions            MeterDefinition[]
  assetMeters                 AssetMeter[]
  meterReadings               MeterReading[]
  maintenanceTypes            MaintenanceType[]
  maintenanceTaskTemplates    MaintenanceTaskTemplate[]
  maintenancePlans            MaintenancePlan[]
  maintenancePlanTasks        MaintenancePlanTask[]
  assetMaintenancePlans       AssetMaintenancePlan[]
  workOrders                  WorkOrder[]
  workOrderTasks              WorkOrderTask[]
  workOrderLabor              WorkOrderLabor[]
  workOrderParts              WorkOrderPart[]
  workOrderStatusHistories    WorkOrderStatusHistory[]
  checklistTemplates          ChecklistTemplate[]
  checklistItems              ChecklistItem[]
  inspections                 Inspection[]
  inspectionResponses         InspectionResponse[]
  faultLogs                   FaultLog[]
  decisionModels              DecisionModel[]
  decisionCriteria            DecisionCriterion[]
  decisionAlternatives        DecisionAlternative[]
  decisionRuns                DecisionRun[]
  attachments                 Attachment[]
  entityAttachments           EntityAttachment[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  offlineSyncBatches          OfflineSyncBatch[]
  decisionPairwiseComparisons DecisionPairwiseComparison[]
  decisionNetworkEdges        DecisionNetworkEdge[]

  @@map("organizations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(320)
  fullName        String    @map("full_name") @db.VarChar(200)
  passwordHash    String?   @map("password_hash") @db.Text
  phone           String?   @db.VarChar(40)
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  memberships              OrganizationMembership[]
  updatedAttributeValues   AssetAttributeValue[]        @relation("AttributeValueUpdatedBy")
  recordedMeterReadings    MeterReading[]               @relation("MeterReadingRecordedBy")
  requestedWorkOrders      WorkOrder[]                  @relation("WorkOrderRequestedBy")
  assignedWorkOrders       WorkOrder[]                  @relation("WorkOrderAssignedTo")
  approvedWorkOrders       WorkOrder[]                  @relation("WorkOrderApprovedBy")
  completedWorkOrderTasks  WorkOrderTask[]              @relation("WorkOrderTaskCompletedBy")
  workOrderLaborRecords    WorkOrderLabor[]             @relation("WorkOrderLaborUser")
  changedWorkOrderStatuses WorkOrderStatusHistory[]     @relation("WorkOrderStatusChangedBy")
  conductedInspections     Inspection[]                 @relation("InspectionInspector")
  submittedResponses       InspectionResponse[]         @relation("InspectionResponseBy")
  reportedFaults           FaultLog[]                   @relation("FaultReportedBy")
  executedDecisionRuns     DecisionRun[]                @relation("DecisionRunExecutedBy")
  uploadedAttachments      Attachment[]                 @relation("AttachmentUploadedBy")
  notifications            Notification[]
  auditLogs                AuditLog[]                   @relation("AuditLogUser")
  syncBatches              OfflineSyncBatch[]           @relation("SyncBatchUser")
  pairwiseComparisons      DecisionPairwiseComparison[] @relation("PairwiseEvaluator")

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  employeeCode   String?          @map("employee_code") @db.VarChar(80)
  jobTitle       String?          @map("job_title") @db.VarChar(150)
  status         MembershipStatus @default(active)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRoles MembershipRole[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId], map: "idx_memberships_user")
  @@map("organization_memberships")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  isSystemRole   Boolean  @default(false) @map("is_system_role")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("roles")
}

model Permission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permissionKey String @unique @map("permission_key") @db.VarChar(120)
  description   String @db.Text

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionId   String @map("permission_id") @db.Uuid

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([organizationId, roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String @map("organization_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  // Relations
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([organizationId, membershipId, roleId])
  @@map("membership_roles")
}

// =============================================================================
// 2. ORGANIZATIONAL SITES AND LOCATION HIERARCHY
// =============================================================================

model Site {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(60)
  name           String   @db.VarChar(200)
  siteType       String?  @map("site_type") @db.VarChar(80)
  addressLine1   String?  @map("address_line1") @db.VarChar(250)
  addressLine2   String?  @map("address_line2") @db.VarChar(250)
  city           String?  @db.VarChar(120)
  region         String?  @db.VarChar(120)
  country        String   @default("Sri Lanka") @db.VarChar(120)
  timezone       String?  @db.VarChar(80)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]
  systems      System[]
  assets       Asset[]
  workOrders   WorkOrder[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("sites")
}

model LocationType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(60)
  name           String  @db.VarChar(120)
  description    String? @db.Text

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("location_types")
}

model Location {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  siteId           String   @map("site_id") @db.Uuid
  parentLocationId String?  @map("parent_location_id") @db.Uuid
  locationTypeId   String   @map("location_type_id") @db.Uuid
  code             String   @db.VarChar(80)
  name             String   @db.VarChar(200)
  description      String?  @db.Text
  floorLabel       String?  @map("floor_label") @db.VarChar(50)
  areaSqm          Decimal? @map("area_sqm") @db.Decimal(14, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locationType LocationType @relation(fields: [locationTypeId], references: [id], onDelete: Restrict)

  // Self-referencing hierarchical relationship
  parent   Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationHierarchy")

  assets      Asset[]
  workOrders  WorkOrder[]
  inspections Inspection[]

  @@unique([organizationId, siteId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, siteId, id])
  @@index([organizationId, siteId, parentLocationId], map: "idx_locations_site_parent")
  @@map("locations")
}

// =============================================================================
// 3. TECHNICAL SYSTEM TAXONOMY AND SYSTEM TREE
// =============================================================================

model SystemCategory {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(60)
  name           String  @db.VarChar(150)
  description    String? @db.Text

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  systemTypes  SystemType[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("system_categories")
}

model SystemType {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  systemCategoryId String  @map("system_category_id") @db.Uuid
  code             String  @db.VarChar(60)
  name             String  @db.VarChar(150)
  description      String? @db.Text

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  systemCategory SystemCategory  @relation(fields: [systemCategoryId], references: [id], onDelete: Cascade)
  systems        System[]
  decisionModels DecisionModel[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("system_types")
}

model System {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  siteId         String           @map("site_id") @db.Uuid
  parentSystemId String?          @map("parent_system_id") @db.Uuid
  systemTypeId   String           @map("system_type_id") @db.Uuid
  code           String           @db.VarChar(80)
  name           String           @db.VarChar(200)
  description    String?          @db.Text
  criticality    CriticalityLevel @default(medium)
  status         SystemStatus     @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  systemType   SystemType   @relation(fields: [systemTypeId], references: [id], onDelete: Restrict)

  // Self-referencing hierarchical relationship
  parent   System?  @relation("SystemHierarchy", fields: [parentSystemId], references: [id], onDelete: Restrict)
  children System[] @relation("SystemHierarchy")

  assets Asset[]

  @@unique([organizationId, siteId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, siteId, id])
  @@index([organizationId, siteId, parentSystemId], map: "idx_systems_site_parent")
  @@map("systems")
}

// =============================================================================
// 4. ASSET MASTER DATA
// =============================================================================

model AssetCategory {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  parentCategoryId String? @map("parent_category_id") @db.Uuid
  code             String  @db.VarChar(60)
  name             String  @db.VarChar(150)
  description      String? @db.Text
  isActive         Boolean @default(true) @map("is_active")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Self-referencing hierarchical relationship
  parent   AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children AssetCategory[] @relation("AssetCategoryHierarchy")

  assetModels              AssetModel[]
  assets                   Asset[]
  categoryAttributes       CategoryAttribute[]
  maintenanceTaskTemplates MaintenanceTaskTemplate[]
  checklistTemplates       ChecklistTemplate[]
  decisionModels           DecisionModel[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("asset_categories")
}

model Brand {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(150)
  website        String? @db.Text
  supportContact String? @map("support_contact") @db.Text

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetModels  AssetModel[]
  assets       Asset[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("brands")
}

model AssetModel {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  brandId         String  @map("brand_id") @db.Uuid
  assetCategoryId String  @map("asset_category_id") @db.Uuid
  modelNumber     String  @map("model_number") @db.VarChar(120)
  modelName       String? @map("model_name") @db.VarChar(180)
  specifications  Json    @default("{}") @db.JsonB

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assetCategory AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  assets        Asset[]

  @@unique([organizationId, brandId, modelNumber])
  @@unique([organizationId, id])
  @@index([specifications(ops: JsonbOps)], type: Gin, map: "idx_asset_models_specs")
  @@map("asset_models")
}

model Asset {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  siteId             String           @map("site_id") @db.Uuid
  assetCategoryId    String           @map("asset_category_id") @db.Uuid
  systemId           String?          @map("system_id") @db.Uuid
  locationId         String           @map("location_id") @db.Uuid
  brandId            String?          @map("brand_id") @db.Uuid
  modelId            String?          @map("model_id") @db.Uuid
  parentAssetId      String?          @map("parent_asset_id") @db.Uuid
  assetCode          String           @map("asset_code") @db.VarChar(100)
  name               String           @db.VarChar(200)
  serialNumber       String?          @map("serial_number") @db.VarChar(150)
  description        String?          @db.Text
  manufacturerDate   DateTime?        @map("manufacturer_date") @db.Date
  installationDate   DateTime?        @map("installation_date") @db.Date
  commissioningDate  DateTime?        @map("commissioning_date") @db.Date
  warrantyExpiryDate DateTime?        @map("warranty_expiry_date") @db.Date
  expectedLifeYears  Decimal?         @map("expected_life_years") @db.Decimal(5, 2)
  criticality        CriticalityLevel @default(medium)
  status             AssetStatus      @default(in_service)
  qrCodeValue        String?          @map("qr_code_value") @db.VarChar(200)
  imageUri           String?          @map("image_uri") @db.Text
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assetCategory AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  system        System?       @relation(fields: [systemId], references: [id], onDelete: SetNull)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model         AssetModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)

  // Self-referencing hierarchical relationship
  parent   Asset?  @relation("AssetHierarchy", fields: [parentAssetId], references: [id], onDelete: Restrict)
  children Asset[] @relation("AssetHierarchy")

  attributeValues       AssetAttributeValue[]
  assetMeters           AssetMeter[]
  assetMaintenancePlans AssetMaintenancePlan[]
  workOrders            WorkOrder[]
  inspections           Inspection[]
  faultLogs             FaultLog[]
  decisionRuns          DecisionRun[]

  @@unique([organizationId, assetCode])
  @@unique([organizationId, id])
  @@index([organizationId, siteId], map: "idx_assets_site")
  @@index([organizationId, locationId], map: "idx_assets_location")
  @@index([organizationId, systemId], map: "idx_assets_system")
  @@index([organizationId, assetCategoryId], map: "idx_assets_category")
  @@index([organizationId, serialNumber], map: "idx_assets_serial")
  @@map("assets")
}

// =============================================================================
// DYNAMIC ATTRIBUTES
// =============================================================================

model AttributeDefinition {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  code           String            @db.VarChar(100)
  name           String            @db.VarChar(150)
  dataType       AttributeDataType @map("data_type")
  unitCode       String?           @map("unit_code") @db.VarChar(40)
  description    String?           @db.Text
  options        Json              @default("[]") @db.JsonB
  isActive       Boolean           @default(true) @map("is_active")

  // Relations
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryAttributes CategoryAttribute[]
  attributeValues    AssetAttributeValue[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("attribute_definitions")
}

model CategoryAttribute {
  organizationId        String  @map("organization_id") @db.Uuid
  assetCategoryId       String  @map("asset_category_id") @db.Uuid
  attributeDefinitionId String  @map("attribute_definition_id") @db.Uuid
  isRequired            Boolean @default(false) @map("is_required")
  displayOrder          Int     @default(0) @map("display_order")
  defaultValue          Json?   @map("default_value") @db.JsonB
  validationRules       Json    @default("{}") @map("validation_rules") @db.JsonB

  // Relations
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetCategory       AssetCategory       @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@id([organizationId, assetCategoryId, attributeDefinitionId])
  @@map("category_attributes")
}

model AssetAttributeValue {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  assetId               String    @map("asset_id") @db.Uuid
  attributeDefinitionId String    @map("attribute_definition_id") @db.Uuid
  valueText             String?   @map("value_text") @db.Text
  valueNumber           Decimal?  @map("value_number") @db.Decimal(20, 6)
  valueBoolean          Boolean?  @map("value_boolean")
  valueDate             DateTime? @map("value_date") @db.Date
  valueDatetime         DateTime? @map("value_datetime") @db.Timestamptz(6)
  valueJson             Json?     @map("value_json") @db.JsonB
  updatedBy             String?   @map("updated_by") @db.Uuid
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
